# DevPulse Environment Configuration (ritualdev-lab)

# Database: Turso (libSQL)
# For local development, leave empty or use file:local.db
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# GitHub OAuth (Optional for local testing, required for 1-click repo sync)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 Object Storage (For large error logs & attachments)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=devpulse-storage
