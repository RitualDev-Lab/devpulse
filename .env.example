# DevPulse environment configuration. Copy to .env.local and fill in your values.
# Never commit real values.

# Public origin of this deployment (links, webhook URLs, SDK snippets).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: host that free subdomains live under (defaults to the NEXT_PUBLIC_APP_URL host).
# NEXT_PUBLIC_PORTAL_DOMAIN=
# Optional: CNAME target customers point custom domains at (defaults to cname.<portal domain>).
# NEXT_PUBLIC_CNAME_TARGET=

# Database: Turso (libSQL). Required; the app throws at startup without it.
# Local development: run `turso dev --db-file local.db` and use the http URL it prints,
# for example http://127.0.0.1:8080. file: URLs are NOT supported (libsql web client).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub OAuth (optional for local testing, required for 1-click repo sync)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required to accept GitHub deploy/push webhooks (unset => 503).
GITHUB_WEBHOOK_SECRET=

# Cloudflare: custom domains (Cloudflare for SaaS) and R2 object storage
CLOUDFLARE_ZONE_ID=
# API token with Zone/Custom Hostnames edit scope (custom domain provisioning).
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=devpulse-storage

# Turnstile bot protection. Unset => protected endpoints refuse requests (fail closed).
TURNSTILE_SECRET_KEY=

# Cron endpoints require this bearer secret.
CRON_SECRET=

# Demo project gate. Only set to "true" on a deployment that should expose prj_ritual_core publicly.
# DEVPULSE_PUBLIC_DEMO_PROJECT=true

# Dodo environment: live (default) or test_mode.
DODO_PAYMENTS_ENVIRONMENT=live
# Sender for alert emails (defaults to alerts@<NEXT_PUBLIC_APP_URL host>).
# DEVPULSE_FROM_EMAIL=
# Session signing secret for SSO. Falls back to ENCRYPTION_MASTER_KEY; required in production.
# SSO_SESSION_SECRET=
# Keyed secret for pseudonymous unique-visitor ids (DAU/WAU/MAU). Unset = visitors are not identified.
# ANALYTICS_HASH_SECRET=
